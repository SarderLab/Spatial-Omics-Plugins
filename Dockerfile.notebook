FROM python:3.12-slim

LABEL maintainer="Sarder Lab <anish.tatke@ufl.edu>, <durgasrit.dongla@ufl.edu>"
LABEL description="SpatialAggregation package for JupyterHub (no Girder/DSA dependencies)"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git build-essential cmake \
    gdal-bin libgdal-dev libpq-dev \
    && rm -rf /var/lib/apt/lists/*

ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal

WORKDIR /opt/Spatial-Omics-Plugins

COPY setup.py README.md ./
COPY SpatialAggregation/ SpatialAggregation/

RUN pip install --upgrade pip setuptools wheel && \
    pip install . --find-links https://girder.github.io/large_image_wheels && \
    rm -rf /root/.cache/pip/*

# Verify the package imports correctly
RUN python -c "from SpatialAggregation import run_aggregation, load_annotations_from_dir, resolve_annotations, save_results; print('SpatialAggregation imported successfully')"
